<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- CONVENTIONS.md "Testing": all infrastructure real via Testcontainers, Mongo and RabbitMQ both —
         never an in-memory substitute for either. -->
    <PackageReference Include="Testcontainers.MongoDb" Version="4.14.0" />
    <PackageReference Include="Testcontainers.RabbitMq" Version="4.14.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\GiftLists.Host\GiftLists.Host.csproj" />
    <!-- GL-75: shared QueueCleanup, rather than the fourth copy of it. GL-43: repinned to 0.2.0
         — the per-repo CI workflow packs BuildingBlocks.Testing from the buildingblocks main
         checkout, which has been at 0.2.0 since Batch 40 (GL-37's LogCapture), so this pin was
         latent-red at restore against local-feed the whole time this project's own copy of
         LogCapture kept it from being noticed locally. -->
    <PackageReference Include="BuildingBlocks.Testing" Version="[0.2.0]" />
  </ItemGroup>
</Project>
